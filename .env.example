# Copy this file to .env and add at least one key (all have free tiers).
# Providers are tried in this order; missing keys are skipped; if one fails, the next is used.
LLM_PROVIDERS=openrouter,groq,gemini,ollama

# Groq — free, very fast. Key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini — free tier via AI Studio. Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter — many free models (ids ending in :free). Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Ollama — 100% free and offline on your own laptop. https://ollama.com  (then: ollama pull llama3.2)
# OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

PORT=8000
# Smart memory: summarise after this many new raw events; keep this many summaries
SUMMARIZE_EVERY=12
KEEP_SUMMARIES=6
